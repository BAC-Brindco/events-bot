{% extends "base.html.j2" %}
{% block body %}
<p style="font-size:12px;color:#555;margin:0">{{ source_tag }} · {{ event_name }}</p>
<h2 style="font-size:18px;margin:6px 0 12px">{{ title }}</h2>
<table style="border-collapse:collapse;margin-bottom:12px">
{% for k in key_numbers %}<tr><td style="padding:2px 12px 2px 0;color:#555">{{ k.label }}</td><td style="padding:2px 0;font-weight:600">{{ k.value_text }}{% if k.note %} <span style="font-weight:400;font-size:11px;color:#777">({{ k.note }})</span>{% endif %}</td></tr>{% endfor %}
</table>
{% for t in tables %}
<p style="margin:12px 0 4px;font-weight:600">{{ t.title }}</p>
<table style="border-collapse:collapse;font-size:13px;margin-bottom:4px">
<tr><th style="text-align:left;padding:2px 10px 2px 0"></th>{% for c in t.cols %}<th style="padding:2px 8px;text-align:right">{{ c }}</th>{% endfor %}</tr>
{% for r in t.rows %}<tr><td style="padding:2px 10px 2px 0;color:#555">{{ r.label }}</td>{% for c in r.cells %}<td style="padding:2px 8px;text-align:right">{{ c }}</td>{% endfor %}</tr>{% endfor %}
</table>
{% if t.note %}<p style="font-size:11px;color:#777;margin:0 0 12px">{{ t.note }}</p>{% endif %}
{% endfor %}
<table style="border-collapse:collapse;font-size:13px;margin-bottom:12px">
<tr><td style="padding:2px 12px 2px 0;color:#555">Release time</td><td>{{ source_time }}</td></tr>
<tr><td style="padding:2px 12px 2px 0;color:#555">First seen</td><td>{{ first_seen }}</td></tr>
</table>
{% if bullets %}<ul>{% for b in bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
{% if failed %}<p style="color:#a00;font-size:13px"><b>EXTRACTION FAILED</b> for: {{ failed|join("; ") }}. Check the source documents below.</p>{% endif %}
<p style="font-size:13px">{% for d in docs %}<a href="{{ d.url }}">{{ d.name }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
{% endblock %}
