{% extends "base.html.j2" %}
{% block body %}
<style>del{background:#fde2e2;color:#8a1c1c}ins{background:#dcf5dc;color:#14532d;text-decoration:none}</style>
<p style="font-size:12px;color:#555;margin:0">FED · FOMC · Stage 2</p>
<h2 style="font-size:18px;margin:6px 0 12px">{{ title }}</h2>

<h3 style="font-size:15px;margin:16px 0 6px">Statement redline vs {{ prior_label or "prior meeting" }}</h3>
{% if red_stats %}
<p style="font-size:12px;color:#555;margin:0 0 6px">{{ red_stats.changed }} sentences changed · {{ red_stats.added }} added · {{ red_stats.removed }} removed · {{ red_stats.unchanged }} unchanged</p>
<div style="font-size:13px;line-height:1.5;border-left:3px solid #ddd;padding-left:10px">{{ redline|safe }}</div>
{% else %}<p>Prior statement not available.</p>{% endif %}

<h3 style="font-size:15px;margin:16px 0 6px">Vote</h3>
<table style="border-collapse:collapse;font-size:13px">
<tr><td style="padding:2px 12px 2px 0;color:#555">This meeting</td><td><b>{{ vote.now }}</b> <span style="font-size:11px;color:#777">{{ vote.now_note }}</span></td></tr>
<tr><td style="padding:2px 12px 2px 0;color:#555">{{ prior_label or "Prior" }}</td><td>{{ vote.prior }} <span style="font-size:11px;color:#777">{{ vote.prior_note }}</span></td></tr>
</table>
<ul style="font-size:13px">
{% for n in vote.new_dissents %}<li>New dissent: <b>{{ n }}</b>, preferred {{ vote.prefs[n] }}</li>{% endfor %}
{% for n in vote.repeat_dissents %}<li>Dissented again: {{ n }}, preferred {{ vote.prefs[n] }}</li>{% endfor %}
{% for n in vote.dropped_dissents %}<li>No longer dissenting: {{ n }}</li>{% endfor %}
{% if not (vote.new_dissents or vote.repeat_dissents or vote.dropped_dissents) %}<li>No dissents at either meeting.</li>{% endif %}
</ul>

{% if sep_rows %}
<h3 style="font-size:15px;margin:16px 0 6px">Projections, medians</h3>
<table style="border-collapse:collapse;font-size:13px">
<tr><th style="text-align:left;padding:2px 10px 2px 0">Variable</th><th style="padding:2px 8px">Year</th><th style="padding:2px 8px;text-align:right">{{ prior_sep_label or "Prior" }}</th><th style="padding:2px 8px;text-align:right">Current</th><th style="padding:2px 8px;text-align:right">Change*</th></tr>
{% for r in sep_rows %}<tr><td style="padding:2px 10px 2px 0;color:#555">{{ r.label }}</td><td style="padding:2px 8px">{{ r.year }}</td><td style="padding:2px 8px;text-align:right">{{ r.prior }}</td><td style="padding:2px 8px;text-align:right"><b>{{ r.current }}</b></td><td style="padding:2px 8px;text-align:right">{{ r.change }}</td></tr>{% endfor %}
</table>
<p style="font-size:11px;color:#777">* Computed: current minus prior, both as extracted from the projections table.</p>
{% endif %}

<h3 style="font-size:15px;margin:16px 0 6px">Policy settings</h3>
<table style="border-collapse:collapse;font-size:13px">
<tr><th style="text-align:left;padding:2px 10px 2px 0"></th><th style="padding:2px 8px;text-align:right">{{ prior_label or "Prior" }}</th><th style="padding:2px 8px;text-align:right">Current</th><th style="padding:2px 8px;text-align:right">Change*</th></tr>
{% for r in impl_rows %}<tr><td style="padding:2px 10px 2px 0;color:#555">{{ r.label }}</td><td style="padding:2px 8px;text-align:right">{{ r.prior }}</td><td style="padding:2px 8px;text-align:right"><b>{{ r.current }}</b></td><td style="padding:2px 8px;text-align:right">{{ r.change }}</td></tr>{% endfor %}
</table>
<p style="font-size:11px;color:#777">* Computed from the extracted values.</p>

<h3 style="font-size:15px;margin:16px 0 6px">Press conference</h3>
<p style="font-size:13px">{{ transcript_status }}</p>
{% if market_line %}<p style="font-size:13px">{{ market_line }}</p>{% endif %}

<p style="font-size:13px">{% for d in docs %}<a href="{{ d.url }}">{{ d.name }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
{% endblock %}
